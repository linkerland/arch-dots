# Customized DistroTube dmenu build, packaged from the sources in this repository.
pkgname=dmenu-distrotube-git
pkgver=5.0.r42.71a03bd
pkgrel=1
pkgdesc="A patched dmenu build with centering, borders, grids, mouse support, fuzzy matching, and highlighting."
arch=('x86_64')
url="https://gitlab.com/dwt1/dmenu-distrotube.git"
license=('MIT')
depends=('ttf-hack' 'ttf-joypixels')
makedepends=('freetype2' 'libx11' 'libxft' 'libxinerama' 'libxrender')
source=()
sha256sums=()

prepare() {
    mkdir -p "$srcdir/$pkgname"
    for entry in "$startdir"/*; do
        [[ -e "$entry" ]] || continue
        case "${entry##*/}" in
            PKGBUILD|src|pkg|*.pkg.tar.*|*.log) continue ;;
        esac
        cp -a -- "$entry" "$srcdir/$pkgname/"
    done
}

build() {
    cd "$srcdir/$pkgname"
    make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11
}

package() {
    cd "$srcdir/$pkgname"
    mkdir -p "$pkgdir/opt/$pkgname"
    cp -rf * "$pkgdir/opt/$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
