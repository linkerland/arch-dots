{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__HOME__/.config/fastfetch/cat.txt",
    "color": {
      "1": "green"
    },
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "host",
      "key": "Host",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk"
    }
  ]
}
