# Customized DistroTube st build, packaged from the sources in this repository.
pkgname=st-distrotube-git
pkgver=0.8.4.r36.d976b03
pkgrel=1
pkgdesc="A heavily patched and customized build of the suckless simple terminal from DistroTube."
arch=('x86_64')
url="https://gitlab.com/dwt1/st-distrotube.git"
license=('MIT')
depends=('ttf-hack' 'ttf-joypixels')
makedepends=('fontconfig' 'freetype2' 'harfbuzz' 'libx11' 'libxft' 'libxrender' 'pkgconf')
source=()
sha256sums=()

prepare() {
    mkdir -p "$srcdir/$pkgname"
    for entry in "$startdir"/*; do
        [[ -e "$entry" ]] || continue
        case "${entry##*/}" in
            PKGBUILD|src|pkg|*.pkg.tar.*|*.log) continue ;;
        esac
        cp -a -- "$entry" "$srcdir/$pkgname/"
    done
}

build() {
    cd "$srcdir/$pkgname"
    make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11
}

package() {
    cd "$srcdir/$pkgname"
    mkdir -p "$pkgdir/opt/$pkgname"
    cp -rf * "$pkgdir/opt/$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
